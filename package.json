{
  "name": "order-processing-system",
  "version": "1.0.0",
  "private": true,
  "description": "MERN order processing system: products, inventory, orders and concurrency-safe checkout.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "start": "npm run start --workspace server",
    "dev:db": "npm run dev:db --workspace server",
    "seed": "npm run seed --workspace server",
    "seed:demo": "npm run seed:demo --workspace server",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server",
    "test:concurrency": "npm run test:concurrency --workspace server",
    "bench": "npm run bench --workspace server",
    "demo:judge": "npm run demo:judge --workspace server",
    "verify:db": "npm run verify:db --workspace server",
    "verify": "npm run test --workspace server && npm run build --workspace client"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}

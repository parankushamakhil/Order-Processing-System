# ---- dependencies ---------------------------------------------------------
node_modules/

# ---- build output ---------------------------------------------------------
# Rebuilt by `npm run build`; never edited by hand.
dist/
client/dist/
*.tsbuildinfo

# ---- environment / secrets ------------------------------------------------
# `.env.example` is the committed contract; real values never enter Git.
.env
.env.local
.env.*.local

# ---- logs -----------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- test and coverage artefacts ------------------------------------------
coverage/
.cache/
client/.vite/

# ---- local MongoDB artefacts ----------------------------------------------
# A replica-set URI plus a data directory that grows to hundreds of megabytes
# after a few test runs; both are machine-local and regenerated by `npm run dev:db`.
server/.dev-mongo-uri
server/.dev-mongo-data/
server/.test-mongo-uri
server/.mongodb-binaries/

# ---- editor and OS noise --------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*~

# ---- tool metadata --------------------------------------------------------
# Local agent/editor state, not project source.
.freebuff/

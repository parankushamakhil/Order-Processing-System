# ---- dependencies ---------------------------------------------------------
node_modules/
**/node_modules/

# ---- build and cache output -----------------------------------------------
# Rebuilt by `npm run build`; never edited by hand.
dist/
build/
client/dist/
*.tsbuildinfo
.vite/
client/.vite/
server/.vite/
**/.vite/
**/.vite-temp/
.cache/
.turbo/
.parcel-cache/

# ---- environment / secrets ------------------------------------------------
# `.env.example` is the committed contract; real values never enter Git.
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ---- logs and runtime diagnostics -----------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
server/.api.log

# ---- test and coverage artefacts ------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
.vitest/

# ---- local MongoDB and database artefacts ---------------------------------
# A replica-set URI plus a data directory that grows to hundreds of megabytes
# after a few test runs; both are machine-local and regenerated by `npm run dev:db`.
server/.dev-mongo-uri
server/.dev-mongo-data/
server/.test-mongo-uri
server/.mongodb-binaries/
*.sqlite
*.sqlite3

# ---- editor and IDE noise -------------------------------------------------
.vscode/
*.code-workspace
.idea/
.vs/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ---- OS and filesystem artifacts ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
[Dd]esktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak

# ---- AI, tool and agent metadata ------------------------------------------
# Local agent/editor state, not project source.
.freebuff/
.agents/
.gemini/
.claude/
.cursor/
scratch/

# ---- documentation and internal reports (excluded from submission) -------
docs/

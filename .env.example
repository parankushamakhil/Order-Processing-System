# ---------------------------------------------------------------------------
# Deployment environment reference.
#
# Nothing here is required for local development: the defaults in
# server/src/config/index.js are valid for dev, and `npm run dev:db` supplies the
# database. Copy to `.env` and adjust when you need to override something:
#
#   cp .env.example .env
#   npm run dev        # or: npm start
#
# No dotenv dependency and no extra flag: server/src/config/loadEnv.js reads this
# file before the schema below is validated, using the runtime's own parser.
# A real environment variable always wins over the file, so a one-off
# `MONGODB_URI=... npm start` overrides it — and a deployment with no `.env` at
# all (the normal case in a container) boots from the platform's variables.
#
# `.env` is gitignored; this example is the committed contract for what may be
# set. To load a differently named file instead, set ENV_FILE=<path>.
# ---------------------------------------------------------------------------

# ---- core -----------------------------------------------------------------
# NODE_ENV also decides how the app is served: `production` turns on
# SERVE_CLIENT (API + built SPA from one port, see docs/DEPLOYMENT.md);
# `development` leaves the client to Vite on :5173.
NODE_ENV=development
PORT=4000

# A replica set is mandatory: MongoDB cannot run multi-document transactions on a
# standalone server, and the checkout saga is built on them. Atlas clusters are
# replica sets by definition. Include the database name in the path.
MONGODB_URI=mongodb://127.0.0.1:27017/orders?replicaSet=rs0

# Signs session tokens. Minimum 16 characters; the boot validator rejects less.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_TTL=2h

# Comma-separated allowlist. Only needed when the client is served from a
# different origin than the API; with SERVE_CLIENT=true they are the same origin
# and this list is unused for same-origin requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret used to sign simulated payment webhooks (HMAC over the raw body).
WEBHOOK_SECRET=dev-webhook-secret

LOG_LEVEL=info
SLOW_QUERY_MS=250

# ---- serving --------------------------------------------------------------
# Serve the built client from the API process. Default: true when
# NODE_ENV=production, otherwise false (Vite serves it in dev).
# SERVE_CLIENT=true

# ---- inventory / checkout timing -----------------------------------------
# How long a reservation holds stock before the reaper may reclaim it.
RESERVATION_TTL_MS=900000
# How long a charge may be in flight before the reaper treats it as abandoned.
# MUST be strictly greater than GATEWAY_TIMEOUT_MS (enforced at boot) so a charge
# always resolves before its own lease can lapse.
PAYMENT_LEASE_MS=30000
GATEWAY_TIMEOUT_MS=5000
CLAIM_LEASE_MS=30000
IDEMPOTENCY_WAIT_MS=2000
IDEMPOTENCY_RETENTION_MS=86400000
MAX_RESERVE_ATTEMPTS=2

# Advisory fast-fail read before opening a transaction. Correctness never depends
# on it; `npm run bench` measures what it is worth (≈−35% on drained stock).
CHECKOUT_FAST_FAIL=true

# ---- reaper ---------------------------------------------------------------
REAPER_INTERVAL_MS=30000
REAPER_BATCH_SIZE=100

# ---- simulated payment gateway -------------------------------------------
PAYMENT_LATENCY_MS=40
# 0..1 — set above 0 to inject random failures into the happy path.
PAYMENT_FAILURE_RATE=0

# ---- limits ---------------------------------------------------------------
MAX_CART_LINES=50
MAX_LINE_QUANTITY=100
CHECKOUT_RATE_LIMIT_PER_MIN=600
MAX_PAGE_SIZE=100

# ---- demo data (only read by `npm run seed:demo`) -------------------------
# SEED_DEMO_SCALE=1
# SEED_DEMO_RANDOM_SEED=20261015
# SEED_DEMO_KEEP=false
# SEED_DEMO_CUSTOMERS=48
# SEED_DEMO_OPEN_HORIZON_MINUTES=120
